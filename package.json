    "aicore:search": "node integration/pipelines/generate_matrix_vector_design.js",
    "commcore:search": "node integration/pipelines/generate_comm_core_design.js",
    "memory:search": "node integration/pipelines/generate_memory_design.js",
    "sram:search": "node integration/pipelines/generate_sram_design.js",
    "coupling:search": "node integration/pipelines/generate_coupling_design.js",
    "area:explore": "node integration/pipelines/generate_die_area_reallocation.js",
    "attribution:cards": "node integration/pipelines/generate_tps_attribution.js",
    "budget:frontier": "node integration/pipelines/generate_budget_frontier.js",
