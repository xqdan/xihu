  "teamMeta": {
    "hardware": {
      "name": "Hardware Team",
      "mission": "定义可实现的 7-reticle 单芯片硬件规格和资源边界",
      "goal": "在面积、带宽、算力、通信、功耗和热约束下形成可制造候选"
    },
    "software": {
      "name": "Software Team",
      "mission": "将模型部署到硬件并通过编译、算子、融合、通信 overlap 和调度提升有效吞吐",
      "goal": "把每项软件收益转化为可执行、可回放、可回滚的 schedule"
    },
    "model": {
      "name": "Model Team",
      "mission": "维护三模型真实性、工作负载、场景和测试验收",
      "goal": "让每个硬件/软件结论都有明确 model、shape、dtype、routing 和测试范围"
    }
  },
