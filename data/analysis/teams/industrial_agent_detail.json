    "flow": {
      "requirements": "ARCH-01 -> MODEL-01/HW-01",
      "contract": "MODEL-02/03 <-> HW-02/03/04/05 <-> SW-01/02",
      "optimization": "SW-03/04/05/06 consumes model+hardware contracts",
      "integration": "ARCH-02 aggregates all teams into candidate and TPS envelope",
      "verification": "VV-01 validates contracts; VV-02 validates timing; VV-03 owns Gate",
      "feedback": "performance miss creates ARCH backflow issue; no direct Gate edit"
    },
    "rules": {
      "oneOwnerPerFile": true,
      "teamPeerReviewBeforeIntegration": true,
      "sharedArtifactsVersioned": true,
      "unverifiedModelNeverFrozen": true,
      "syntheticEventsNeverQGatePass": true,
      "softwareGainMustHaveImplementationPrecondition": true,
      "hardwareProfileMustNotBeChangedBySoftware": true
    }
