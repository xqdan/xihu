  "ruled": {
    "instances": {
      "chosen": "one per die",
      "reason": "the simulator keeps one collective in flight per die and the chosen design is busy for a few percent of the token; one per package would add a die-to-die hop to every trigger"
    },
    "txRxEngines": {
      "chosen": "separate TX and RX state machines",
      "reason": "inbound commits must not queue behind WQE generation of the next collective"
    },
    "dataSemantics": {
      "chosen": "memory semantics (one-sided put/get/atomic on global addresses)",
      "reason": "send/recv needs a posted receive buffer and tag matching per message; slots are reserved per epoch instead"
    },
    "aiCoreRemoteAccess": {
      "chosen": "posted store/atomic and FENCE only",
      "reason": "a remote load stalls the Core for at least one round trip (remoteLoadMinUs in the output); B=1 decode keeps it off the critical path"
    },
    "addressing": {
      "chosen": "symmetric global address (rank, die, region, offset) with protection key and generation",
      "reason": "templates store offsets only and stay card-independent"
    }
